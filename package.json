{
  "name": "prephatch",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20 <21"
  },
  "scripts": {
    "dev": "./scripts/use-project-node.sh next dev",
    "build": "./scripts/use-project-node.sh next build",
    "start": "./scripts/use-project-node.sh next start",
    "lint": "./scripts/use-project-node.sh next lint",
    "seed:dev": "./scripts/seed-dev-data.sh",
    "test": "./scripts/use-project-node.sh vitest run",
    "typecheck": "./scripts/use-project-node.sh tsc --noEmit",
    "free-mock:hosted": "./scripts/use-project-node.sh node scripts/free-mock-flow.mjs",
    "smoke:free-mock-route": "ALLOW_DEV_BYPASS=true ./scripts/use-project-node.sh node scripts/free-mock-route-smoke.mjs",
    "test:free-mock-flow": "./scripts/use-project-node.sh node scripts/free-mock-flow.test.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.10.2",
    "@supabase/supabase-js": "^2.105.3",
    "next": "^14.2.32",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@types/node": "20.14.10",
    "@types/react": "18.2.48",
    "@types/react-dom": "18.2.18",
    "autoprefixer": "10.4.20",
    "eslint": "8.57.0",
    "eslint-config-next": "^14.2.32",
    "postcss": "8.4.41",
    "prettier": "3.3.3",
    "tailwindcss": "3.4.10",
    "typescript": "5.5.4",
    "vitest": "^4.1.2"
  }
